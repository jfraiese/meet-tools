-- Opens Chrome with --allowlisted-extension-id=<Meet Recorder's id>.
--
-- With that flag Chrome lets the extension capture a tab it was not invoked
-- on, which is what allows a recording to start by itself when a call begins.
-- The flag only counts if Chrome starts with it, so when Chrome is already
-- running without it this offers a restart.
--
-- Generated by build.sh, which fills in the id. Do not edit the copy inside
-- the built app; edit this and rebuild.

property extId : "__EXTENSION_ID__"
property appTitle : "__APP_NAME__"

on chromeRunning()
	return (do shell script "pgrep -x 'Google Chrome' >/dev/null && echo yes || echo no") is "yes"
end chromeRunning

on chromeHasFlag()
	set f to "--allowlisted-extension-id=" & extId
	return (do shell script "ps -o command= -p \"$(pgrep -x 'Google Chrome' | head -1)\" | grep -qF -- " & quoted form of f & " && echo yes || echo no") is "yes"
end chromeHasFlag

on launchChrome(extra)
	do shell script "open -a 'Google Chrome' --args --allowlisted-extension-id=" & extId & extra
end launchChrome

on run
	if not chromeRunning() then
		launchChrome("")
	else if chromeHasFlag() then
		tell application "Google Chrome" to activate
	else
		set answer to button returned of (display dialog "Chrome is open without Meet auto-recording." & return & return & "Restart it? Your windows and tabs come back." buttons {"Leave it", "Restart Chrome"} default button "Restart Chrome" with icon caution with title appTitle)
		if answer is "Restart Chrome" then
			tell application "Google Chrome" to quit
			repeat 100 times
				if not chromeRunning() then exit repeat
				delay 0.2
			end repeat
			if chromeRunning() then
				display dialog "Chrome did not quit — a dialog may be open (a download in progress, for example). Close it and try again." buttons {"OK"} default button 1 with title appTitle
				return
			end if
			-- --restore-last-session: Chrome's default is to open a new tab page
			-- on startup, and without this the restart would lose your tabs.
			launchChrome(" --restore-last-session")
		else
			tell application "Google Chrome" to activate
		end if
	end if
end run
